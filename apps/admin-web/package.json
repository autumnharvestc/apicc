{
  "name": "@apicc/admin-web",
  "version": "0.1.0",
  "private": true,
  "description": "开源、本地优先的 API 全生命周期平台（浏览器管理控制台：工作区/成员/项目 ACL 管理）",
  "author": "autumnharvestc",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
