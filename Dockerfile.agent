# Exact runtime tuple is admitted only after the shared Core semantic fixture passes.
FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90 AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate
ENV npm_config_verify_deps_before_run=false
COPY pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/plugin-sdk/package.json packages/plugin-sdk/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/execution/package.json packages/execution/package.json
COPY packages/cli/package.json packages/cli/package.json
COPY apps/desktop/package.json apps/desktop/package.json
COPY apps/admin-web/package.json apps/admin-web/package.json
COPY apps/runner-agent/package.json apps/runner-agent/package.json
RUN --mount=type=cache,id=apicc-pnpm11-store,target=/root/.local/share/pnpm/store pnpm --config.verify-deps-before-run=false --filter @apicc/runner-agent... install --frozen-lockfile
COPY packages/ packages/
COPY apps/ apps/
RUN pnpm --config.verify-deps-before-run=false -C packages/plugin-sdk build \
 && pnpm --config.verify-deps-before-run=false -C packages/core build \
 && pnpm --config.verify-deps-before-run=false -C packages/execution build \
 && pnpm --config.verify-deps-before-run=false -C apps/runner-agent build

FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/runner-agent ./apps/runner-agent
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME /data
# compose supplies init:true; docker run users must pass --init for signal forwarding/reaping.
ENTRYPOINT ["node", "apps/runner-agent/dist/main.js"]
CMD ["/run/apicc/deployment.json"]
