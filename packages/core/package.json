{
  "name": "@apicc/core",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/shared.d.ts",
        "default": "./dist/shared.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/context": {
      "types": "./dist/assets/context.d.ts",
      "default": "./dist/assets/context.js"
    },
    "./design/document": {
      "types": "./dist/design/document.d.ts",
      "default": "./dist/design/document.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./assert/regex": {
      "types": "./dist/assert/regex.d.ts",
      "default": "./dist/assert/regex.js"
    },
    "./report/units": {
      "types": "./dist/report/units.d.ts",
      "default": "./dist/report/units.js"
    },
    "./workflow/adapter": {
      "types": "./dist/workflow/adapter.d.ts",
      "default": "./dist/workflow/adapter.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@apicc/plugin-sdk": "workspace:*",
    "@napi-rs/keyring": "2.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "jsonpath-plus": "^10.4.0",
    "re2js": "2.8.8",
    "semver": "7.8.5",
    "tough-cookie": "6.0.2",
    "ulid": "^3.0.2",
    "undici": "^8.10.1",
    "ws": "8.21.3",
    "xpath": "^0.0.34",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
