# All paths are deployment inputs; do not store real tokens, keys or certificates here.
APICC_SERVER_IMAGE=apicc-server:local
APICC_AGENT_IMAGE=apicc-runner-agent:local
APICC_AGENT_TMPFS_SIZE=4g
APICC_HTTPS_PORT=8443
APICC_CONTROL_BASE_URL=https://control.example.test:8443/api/v1
APICC_SERVER_ADMIN_USERNAME=admin
APICC_SERVER_ADMIN_PASSWORD=REPLACE_WITH_DEPLOYMENT_SECRET
APICC_TLS_DIRECTORY=./secrets/tls
APICC_MASTER_KEY_FILE=./secrets/materials-key
APICC_AGENT_CONFIG_FILE=./secrets/deployment.json
APICC_AGENT_TOKEN_FILE=./secrets/agent-token
APICC_AGENT_CA_FILE=./secrets/control-ca.pem
APICC_TLS_STORE_PASSWORD=REPLACE_WITH_PKCS12_PASSWORD
