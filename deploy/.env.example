# apicc 服务端容器环境变量样例——复制为 deploy/.env 后按需修改。
# 变量名 = application.yml 属性的点/连字符转下划线（Spring 宽松绑定）。

# 首个管理员账号（仅在 users 表为空时生效；重启不会覆盖既有账号）
APICC_SERVER_ADMIN_USERNAME=admin
APICC_SERVER_ADMIN_PASSWORD=change-me-please

# 注册开关：默认关（首个账号走引导）。批量拉人时临时改为 true 并重启，拉完改回。
APICC_SERVER_ALLOW_REGISTRATION=false

# 端口 / 数据目录 / 元数据库 / 令牌有效期（默认值如下，按需覆盖）
# SERVER_PORT=8080
# APICC_SERVER_DATADIR=/data
# SPRING_DATASOURCE_URL=jdbc:h2:file:/data/metadata
# APICC_SERVER_TOKEN_TTL_DAYS=30
